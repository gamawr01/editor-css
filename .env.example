# Copie este arquivo para .env e preencha com sua chave.
# Todos os provedores usam o protocolo da OpenAI — só troque o provedor e a chave.

# Opções: groq | nvidia | gemini | cerebras | ollama
LLM_PROVIDER=groq

# Groq          → https://console.groq.com/keys           (começa com "gsk_")
# NVIDIA NIM    → https://build.nvidia.com                (começa com "nvapi-")
# Google Gemini → https://aistudio.google.com/apikey
# Cerebras      → https://cloud.cerebras.ai
# Ollama (local)→ não precisa de chave
LLM_API_KEY=cole_sua_chave_aqui

# Opcional — sobrepõe o modelo padrão do provedor:
# LLM_MODEL=openai/gpt-oss-120b

# Opcional — sobrepõe a URL base do provedor:
# LLM_BASE_URL=
